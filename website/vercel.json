{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/promotion/:slug",
      "destination": "/promotion",
      "permanent": false
    },
    {
      "source": "/combo",
      "destination": "/promotion",
      "permanent": true
    },
    {
      "source": "/combo/:slug",
      "destination": "/promotion/:slug",
      "permanent": true
    },
    {
      "source": "/tin-tuc",
      "destination": "/beauty-vlog",
      "permanent": true
    },
    {
      "source": "/tin-tuc/:slug",
      "destination": "/beauty-vlog/:slug",
      "permanent": true
    },
    {
      "source": "/khuyen-mai/:path*",
      "destination": "/promotion",
      "permanent": true
    },
    {
      "source": "/trang-chu",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/gioi-thieu",
      "destination": "/ve-moana",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/ve-moana",
      "permanent": true
    },
    {
      "source": "/dich-vu",
      "destination": "/lieu-trinh",
      "permanent": true
    },
    {
      "source": "/dich-vu/:path*",
      "destination": "/lieu-trinh",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/lieu-trinh",
      "permanent": true
    },
    {
      "source": "/bang-gia-dich-vu",
      "destination": "/bang-gia",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/san-pham",
      "permanent": true
    },
    {
      "source": "/cua-hang",
      "destination": "/san-pham",
      "permanent": true
    },
    {
      "source": "/product/:path*",
      "destination": "/san-pham",
      "permanent": true
    },
    {
      "source": "/product-category/:path*",
      "destination": "/san-pham",
      "permanent": true
    },
    {
      "source": "/danh-muc-san-pham/:path*",
      "destination": "/san-pham",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/san-pham",
      "permanent": true
    },
    {
      "source": "/gio-hang",
      "destination": "/san-pham",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "/san-pham",
      "permanent": true
    },
    {
      "source": "/thanh-toan",
      "destination": "/san-pham",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/beauty-vlog",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/beauty-vlog",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/beauty-vlog",
      "permanent": true
    },
    {
      "source": "/tag/:path*",
      "destination": "/beauty-vlog",
      "permanent": true
    },
    {
      "source": "/khuyen-mai",
      "destination": "/promotion",
      "permanent": true
    },
    {
      "source": "/uu-dai",
      "destination": "/promotion",
      "permanent": true
    },
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:path*",
      "destination": "/beauty-vlog",
      "permanent": true
    },
    {
      "source": "/lien-he-moana",
      "destination": "/lien-he",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/lien-he",
      "permanent": true
    },
    {
      "source": "/dat-lich",
      "destination": "https://spa-manager-five.vercel.app/dat-lich",
      "permanent": false
    },
    {
      "source": "/booking",
      "destination": "https://spa-manager-five.vercel.app/dat-lich",
      "permanent": false
    },
    {
      "source": "/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/wp-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
